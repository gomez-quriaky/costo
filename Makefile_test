FC = gfortran
CC = gcc

MKLROOT = /opt/intel/oneapi/mkl/latest

current_dir = $(shell pwd)

FFLAGS = -g 

FFLAGS = -O2 
CFLAGS = -O2 -Iinclude

FINCLUDE = -I$(MKLROOT)/include/intel64/lp64  -Isblas -IINTERF -IDECLA

FLIB =  -L${MKLROOT}/lib -Wl,--no-as-needed -lmkl_gf_lp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl

MOD_DIR = sblas

CINCLUDE = lib_C
CSRC_FILES = tesseroid.c


F90SRC =\
		sblas/mkl_spblas.f90 \
		read_layer.f90 \
		read_modd.f90 \
		read_modv.f90 \
