		ddiffergr.f90 \
		calgradio.f90 \
		joint_inv.f90 


 
OBJ = $(F90SRC:.f90=.o) $(CSRC_FILES:.c=.o)

# Executable name
EXE = costo

# Build rules
all: $(EXE)

$(EXE): $(OBJ)
	$(FC) $(LFLAGS) -o $@ $^ $(LIBS) 
	
%.o: %.f90
	$(FC) $(FFLAGS) $(FINCLUDE) -J$(MOD_DIR) -c $< -o $@

%.o: %.c
	$(CC) $(CFLAGS) $(CINCLUDE) -c $< -o $@

# Clean rule
clean:
	rm -f $(OBJ) $(EXE) $(MOD_DIR)/*.mod  mod_*.mod
	rm *.o

.PHONY: all clean