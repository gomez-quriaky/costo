		ttmder.f90 \
		simplex.f90 \
		rayweb.f90 \
		forw.f90 \
		frechet.f90 \
		caldt.f90 \
		findnod.f90 \
		zeroav.f90 \
		dsmooth.f90 \
		vsmooth.f90 \
		ddiffer.f90 \
		vdiffer.f90 \
		bdiffer.f90 \
		calgra.f90 \
		contbod.f90 \
		contnod.f90 \
		bcalc.f90 \
		denvel.f90 \
